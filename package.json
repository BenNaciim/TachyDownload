{
  "name": "tachy-download",
  "productName": "Tachy Download",
  "version": "1.2.0",
  "description": "Gestionnaire de téléchargement : segments parallèles, reprise, file d'attente, limite de vitesse, planification, extension navigateur.",
  "author": "Tachy Download",
  "main": "src/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "icon": "node tools/make-icon.js",
    "dist": "tauri build --bundles nsis",
    "release": "node tools/release.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.12.4",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  },
  "build": {
    "appId": "local.downloadmanager.app",
    "productName": "Tachy Download",
    "copyright": "MIT",
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "compression": "maximum",
    "afterPack": "tools/after-pack.js",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tachy Download",
      "uninstallDisplayName": "Tachy Download",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Tachy-Download-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "undici": "^7.30.1"
  }
}
