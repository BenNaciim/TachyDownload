{
  "manifest_version": 3,
  "name": "Tachy Download – Intégration",
  "version": "1.0.3",
  "description": "Envoie les téléchargements et les vidéos des pages web vers l'application Tachy Download installée sur cet ordinateur. Chrome, Edge et Firefox.",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "cookies",
    "webRequest",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "Tachy Download",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "download-manager@local.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
